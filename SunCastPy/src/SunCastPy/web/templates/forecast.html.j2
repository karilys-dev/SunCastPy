<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="keywords" content="weather" />
        <meta name="description" content="weather forecast" />
        <title>SunCast Forecast</title>
        {% if show_api_controls | default(false) %}
            <link rel="stylesheet"
                  href="{{ url_for('static', path='/css/forecast.css') }}">
        {% else %}
            <style>{% include "css/forecast.css" %}</style>
        {% endif %}
    </head>
    <body>
        <h1>🌤 SunCast Forecast</h1>
        <h2 style="text-align: center;">{{ location }}</h2>
        {% if show_api_controls | default(false) %}
            {% include "partials/forecast_controls.html.j2" %}
        {% endif %}
        {% for day, forecasts in grouped.items() %}
            <div class="day">
                <h2>{{ day }}</h2>
                <table>
                    {% for f in forecasts %}
                        <tr>
                            <td>
                                <img src="{{ f.image_url }}"
                                     width="80"
                                     height="80"
                                     alt="{{ f.short_forecast }}">
                            </td>
                            <td>
                                <div class="forecast">
                                    <strong>{{ format_hour(f.start_time) }} - {{ format_hour(f.end_time) }}</strong>
                                    <br>
                                    {{ f.short_forecast }}
                                    <br>
                                    Temp: {{ f.temperature }}°{{ f.temperature_unit }}
                                    <br>
                                    Wind: {{ f.wind_speed }} {{ f.wind_direction }}
                                    <br>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            </div>
        {% endfor %}
    </body>
</html>
