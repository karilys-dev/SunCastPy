<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="keywords" content="weather" />
        <meta name="description" content="weather forecast" />
        <link rel="stylesheet"
              href="{{ url_for('static', path='css/forecast.css') }}">
    </head>
    <head>
        <title>SunCast Forecast</title>
        <style>
            body {
                font-family: Arial, sans-serif;
                background: #0f172a;
                color: #e2e8f0;
                padding: 20px;
            }
            h1 {
                text-align: center;
            }
            .day {
                margin-bottom: 20px;
                padding: 15px;
                border-radius: 10px;
                background: #1e293b;
            }
            .forecast {
                margin-left: 10px;
                padding: 5px 0;
                border-bottom: 1px solid #334155;
            }
        </style>
    </head>
    <body>
        <h1>🌤 SunCast Forecast</h1>
        <h2 style="text-align: center;">{{ location }}</h2>
        <form method="get"
              action="/forecast/{{ location }}"
              id="learningForm"
              class="forecast-controls">
            <fieldset class="control-group">
                <legend>Summarize?</legend>
                <label>
                    <input type="radio"
                           name="summarize"
                           value="true"
                           {% if summarize %}checked{% endif %}
                           onchange="this.form.submit()">
                    Yes
                </label>
                <label>
                    <input type="radio"
                           name="summarize"
                           value="false"
                           {% if not summarize %}checked{% endif %}
                           onchange="this.form.submit()">
                    No
                </label>
            </fieldset>
            <div class="control-group">
                <label for="limit">Extended Forecast</label>
                <select name="limit" id="limit" onchange="this.form.submit()">
                    <option value="1" {% if limit == 1 %}selected{% endif %}>1</option>
                    <option value="5" {% if limit == 5 %}selected{% endif %}>5</option>
                    <option value="7" {% if limit == 7 %}selected{% endif %}>7</option>
                </select>
            </div>
        </form>
        {% for day, forecasts in grouped.items() %}
            <div class="day">
                <h2>{{ day }}</h2>
                <table>
                    {% for f in forecasts %}
                        <tr>
                            <td>
                                <img src="{{ f.image_url }}"
                                     width="80"
                                     height="80"
                                     alt="{{ f.short_forecast }}">
                            </td>
                            <td>
                                <div class="forecast">
                                    <strong>{{ format_hour(f.start_time) }} - {{ format_hour(f.end_time) }}</strong>
                                    <br>
                                    {{ f.short_forecast }}
                                    <br>
                                    Temp: {{ f.temperature }}°{{ f.temperature_unit }}
                                    <br>
                                    Wind: {{ f.wind_speed }} {{ f.wind_direction }}
                                    <br>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            </div>
        {% endfor %}
    </body>
</html>
